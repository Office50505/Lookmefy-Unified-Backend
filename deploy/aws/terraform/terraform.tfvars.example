aws_region  = "ap-south-1"
key_name    = "replace-with-your-ec2-keypair-name"
ssh_cidr    = "replace-with-your-public-ip/32"
repo_url    = "https://github.com/Office50505/Lookmefy-Unified-Backend.git"
repo_branch = "main"

enable_aws_cost_explorer      = true
backend_iam_role_name         = "FitlookBackendEc2Role"
backend_instance_profile_name = "FitlookBackendInstanceProfile"

backend_env = {
  MONGODB_URI = "mongodb+srv://user:password@example.mongodb.net/fitlook"
  MONGODB_DB  = "fitlook"
  JWT_SECRET  = "replace-with-a-long-random-secret"

  PASSWORD_HASH_SCHEME    = "bcrypt-hmac-sha384-v2"
  PASSWORD_PEPPER_ACTIVE_ID = "v1"
  PASSWORD_PEPPER_V1      = "replace-with-a-long-random-pepper"

  OTP_DELIVERY_PROVIDER = "msg91"
  MSG91_AUTH_KEY        = "replace-with-msg91-auth-key"
  MSG91_TEMPLATE_ID     = "replace-with-msg91-template-id"

  PHONEPE_ENABLED = "false"
  RAZORPAY_ENABLED    = "true"
  RAZORPAY_KEY_ID     = "replace-with-razorpay-key-id"
  RAZORPAY_KEY_SECRET = "replace-with-razorpay-key-secret"

  APPLE_IAP_ENABLED = "false"

  AI_FEATURES_ENABLED          = "true"
  TRYON_TOKEN_COST             = "1"
  TRYON_VIDEO_TOKEN_COST       = "3"
  AI_PROVIDER                  = "pruna"
  TRYON_VIDEO_PROVIDER         = "pixverse"
  PROFILE_FULL_BODY_GENERATION = "true"
  CLOSET_GENERATION_ENABLED    = "true"
  PRUNA_API_KEY                = "replace-with-pruna-api-key"
  PRUNA_BASE_URL               = "https://api.pruna.ai"
  PRUNA_TRYON_MODEL            = "p-image-try-on"
  PRUNA_VIDEO_MODEL            = "p-video"
  FAL_KEY                      = "replace-with-fal-key"
  FAL_TRYON_VIDEO_MODEL        = "fal-ai/pixverse/v6/image-to-video"
  FITROOM_API_KEY              = "replace-with-fitroom-api-key"
  FITROOM_BASE_URL             = "https://platform.fitroom.app"

  CATALOG_SEARCH_PROVIDER = "serpapi"
  SERPAPI_API_KEY         = "replace-with-serpapi-api-key"
  AMAZON_MARKETPLACE      = "www.amazon.in"
  AMAZON_ASSOCIATE_TAG    = "optional-amazon-associate-tag"

  STORAGE_PROVIDER = "local"

  BACKGROUND_REMOVAL_PROVIDER = "edge-mask"
  BACKGROUND_REMOVAL_PYTHON   = ".venv-rembg/bin/python"

  SIGNUP_FREE_TOKENS               = "8"
  SIGNUP_DEV_MODE_DEFAULT          = "false"
  ENABLE_DEV_MODE                  = "false"
  PRODUCT_READ_CACHE_TTL_MS        = "300000"
  RECOMMENDATION_READ_CACHE_TTL_MS = "300000"
  TRYON_IMAGE_CACHE_TTL_MS         = "900000"
  TRYON_IMAGE_CACHE_MAX_ITEMS      = "80"
  REDIS_TIMEOUT_MS                 = "250"
  TEMP_SESSION_REQUIRE_REDIS       = "true"
  QUEUE_ENABLED                    = "true"
  TRYON_QUEUE_MODE                 = "off"
  RUN_WORKER_ON_API                = "false"
  RATE_LIMIT_GLOBAL_MAX            = "3000"
  RATE_LIMIT_GLOBAL_WINDOW_MS      = "300000"
  JOB_STATUS_RATE_LIMIT_MAX        = "1200"
  JOB_STATUS_RATE_LIMIT_WINDOW_MS  = "300000"
}
