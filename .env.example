# Authentication / OTP
# Strong JWT signing secret for user sessions.
JWT_SECRET=
# Password storage: HMAC-SHA-384 with a server-only pepper, followed by bcrypt.
PASSWORD_HASH_SCHEME=bcrypt-hmac-sha384-v2
PASSWORD_BCRYPT_ROUNDS=12
# Use a non-secret identifier. The matching secret must be at least 32 random bytes.
PASSWORD_PEPPER_ACTIVE_ID=v1
# Store the real value in AWS Secrets Manager/SSM and inject it into the backend only.
PASSWORD_PEPPER_V1=
# OTP provider: use "msg91" or "webhook" in production, or "disabled" to keep OTP unavailable.
# Blank uses local mock delivery outside production.
OTP_DELIVERY_PROVIDER=
# Native MSG91 V5 SendOTP credentials. Keep the auth key server-side only.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
# HTTPS server-to-server endpoint that sends OTP SMS/messages in production.
OTP_DELIVERY_WEBHOOK_URL=
# Optional bearer token sent to the OTP webhook Authorization header.
OTP_DELIVERY_WEBHOOK_TOKEN=
# Per-attempt webhook timeout in milliseconds.
OTP_DELIVERY_TIMEOUT_MS=5000
# Total webhook attempts. Retries apply only to network/timeout/429/5xx failures.
OTP_DELIVERY_RETRY_ATTEMPTS=1
# Delay between retry attempts in milliseconds.
OTP_DELIVERY_RETRY_DELAY_MS=250
# Server-local JSONL mock store for local/automated tests only. Defaults to the OS temp directory outside production.
OTP_MOCK_STORE_PATH=
# Optional fixed OTP. In production this requires ALLOW_FIXED_OTP_IN_PRODUCTION=true. Example: 123456.
OTP_FIXED_CODE=
# Temporary production testing switch for fixed OTP. Disable before public launch.
ALLOW_FIXED_OTP_IN_PRODUCTION=false
# Local/manual testing helper that lets the UI fetch mock-delivered OTPs. Enabled by default outside production unless set false.
ENABLE_TEST_OTP_HELPER=true
# Frontend switch for showing the local OTP helper button in Vite dev/test only. Set false to hide it.
VITE_ENABLE_TEST_OTP_HELPER=true
# Free credits granted at account creation.
SIGNUP_FREE_TOKENS=0
# Local development bypass controls. Never enable in production.
ENABLE_DEV_MODE=false
SIGNUP_DEV_MODE_DEFAULT=false
# Disable OTP request/verify rate limits and incorrect-attempt lockout outside production.
DISABLE_AUTH_OTP_RATE_LIMITS=false

# PhonePe
# Set false to keep payments unavailable while allowing the API to run without PhonePe credentials.
PHONEPE_ENABLED=false
# PhonePe Standard Checkout v2 environment: sandbox/preprod/production.
PHONEPE_ENV=sandbox
# OAuth client id from the PhonePe merchant portal.
PHONEPE_CLIENT_ID=
# OAuth client secret from the PhonePe merchant portal.
PHONEPE_CLIENT_SECRET=
# OAuth client version from the PhonePe merchant portal.
PHONEPE_CLIENT_VERSION=
# Optional merchant id for operations/docs that require it. Current v2 checkout code does not send it.
PHONEPE_MERCHANT_ID=
# Optional override for PhonePe PG base URL. Leave blank to use env defaults.
PHONEPE_BASE_URL=
# Optional override for PhonePe OAuth URL. Leave blank to use env defaults.
PHONEPE_AUTH_URL=
# HTTPS redirect URL for user-facing return from PhonePe. Defaults to CLIENT_ORIGIN/tokens.
PHONEPE_REDIRECT_URL=
# Dashboard-configured callback username for PhonePe v2 callback validation.
PHONEPE_CALLBACK_USERNAME=
# Dashboard-configured callback password for PhonePe v2 callback validation.
PHONEPE_CALLBACK_PASSWORD=
# PhonePe order expiry window.
PHONEPE_ORDER_EXPIRE_SECONDS=1200
# Short-poll fallback after creating a PhonePe checkout.
PHONEPE_SHORT_POLL_ATTEMPTS=6
PHONEPE_SHORT_POLL_MS=5000

# Razorpay
# Test or live API keys from the Razorpay Dashboard. Keep the key secret server-side only.
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional mode-aware Razorpay keys. Admin Settings can switch RAZORPAY_MODE between test and live.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_MONTHLY_PLAN_ID=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_MONTHLY_PLAN_ID=
RAZORPAY_LIVE_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTIONS_ENABLED=false
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
# Optional override for tests only. Leave blank to use https://api.razorpay.com/v1.
RAZORPAY_BASE_URL=

# Apple In-App Purchases
# Enables iOS StoreKit purchase verification and App Store Server Notifications.
APPLE_IAP_ENABLED=false
APPLE_IAP_ENVIRONMENT=sandbox
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_BUNDLE_ID=com.lookmefy.app
# Required only for production App Store Server API calls.
APPLE_APP_APPLE_ID=
# Use either inline escaped PEM or a server-local file path.
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=
# Use one of these certificate sources for signed payload verification.
APPLE_ROOT_CA_CERTS_BASE64=
APPLE_ROOT_CA_CERT_PATHS=
APPLE_ROOT_CA_CERTS_DIR=

# Database
# MongoDB connection string.
MONGODB_URI=
# Optional MongoDB database name.
MONGODB_DB=fitlook
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# Queue
# Redis connection for queues, rate limits, cache, and production temp sessions.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=fitlook
REDIS_TIMEOUT_MS=250
REDIS_CONNECT_TIMEOUT_MS=1000
# Require Redis for OTP/temp sessions in production-like deployments.
TEMP_SESSION_REQUIRE_REDIS=true
QUEUE_ENABLED=true
QUEUE_PREFIX=fitlook
QUEUE_WORKER_CONCURRENCY=2
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=5000
RUN_WORKER_ON_API=false
PROFILE_FULL_BODY_QUEUE_MODE=inline
PROFILE_WORKER_CONCURRENCY=1
MAINTENANCE_WORKER_CONCURRENCY=1
TRYON_WORKER_CONCURRENCY=1
TRYON_QUEUE_MODE=off
TRYON_QUEUE_WAIT_TIMEOUT_MS=180000
JOB_STATUS_RATE_LIMIT_MAX=1200
JOB_STATUS_RATE_LIMIT_WINDOW_MS=300000

# App URLs
PORT=5050
APP_ROLE=api
VITE_API_BASE_URL=
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_STORE_BASE_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
ALLOWED_ORIGINS=
ALLOW_LOCAL_ORIGINS=true
TRUST_PROXY=true

# Admin / Operations
# Admins request access with their own email/password. Bootstrap the first Master with npm run admin:bootstrap-master.
GRACEFUL_SHUTDOWN_TIMEOUT_MS=25000
STRUCTURED_REQUEST_LOGS=true
CONSOLE_LOG_MIN_STATUS=500
SLOW_REQUEST_MS=1000
MONGO_SLOW_QUERY_LOGS=true
MONGO_SLOW_QUERY_MS=250
LOG_LEVEL=info
LOKI_ENABLED=false
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_LABEL_APP=lookmefy-api
LOKI_BATCH_MS=1000
LOKI_BATCH_SIZE=50
LOKI_TIMEOUT_MS=1500
IP_BLOCKLIST_ENABLED=true
IP_BLOCKLIST_CACHE_MS=30000
SECURITY_FILTERS_ENABLED=true
SECURITY_AUTO_BLOCK_ENABLED=true
SECURITY_AUTO_BLOCK_THRESHOLD=8
SECURITY_AUTO_BLOCK_WINDOW_MS=300000
SECURITY_AUTO_BLOCK_TTL_MS=3600000
RATE_LIMIT_GLOBAL_WINDOW_MS=300000
RATE_LIMIT_GLOBAL_MAX=3000
NGINX_STATUS_URL=http://127.0.0.1/nginx_status
NGINX_STATUS_TIMEOUT_MS=500
OPERATIONS_RETENTION_DAYS=180
PERSIST_REQUEST_METRICS=true
REQUEST_METRICS_FLUSH_MS=10000
REQUEST_METRICS_RETENTION_DAYS=30
ADMIN_METRICS_WINDOW_HOURS=24
# Long random bearer token used only by Prometheus/CloudWatch collectors at /api/metrics/prometheus.
METRICS_BEARER_TOKEN=
PROVIDER_HEALTH_TIMEOUT_MS=5000
PROVIDER_API_TIMEOUT_MS=8000

# Admin cost estimates and manually reconciled amounts. Leave blank rather than entering an unverified value.
ADMIN_MONTHLY_BUDGET_USD=
OTP_COST_PER_MESSAGE_USD=
RAZORPAY_FEE_PERCENT=
RAZORPAY_FEE_FIXED_INR=
AWS_MONTHLY_COST_USD=
AWS_MONTHLY_BUDGET_USD=
# Enable live AWS Cost Explorer. Prefer an EC2 instance role with ce:GetCostAndUsage over static keys.
AWS_COST_EXPLORER_ENABLED=false
AWS_COST_CACHE_MS=21600000
AWS_PROFILE=
# Optional local/non-EC2 credentials. Leave blank on EC2 when an instance role is attached.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MONGODB_MONTHLY_COST_USD=
# Atlas service account with Organization Billing Viewer access.
MONGODB_ATLAS_CLIENT_ID=
MONGODB_ATLAS_CLIENT_SECRET=
MONGODB_ATLAS_ORG_ID=
BUNNY_STORAGE_COST_PER_GB_USD=
BUNNY_ACCOUNT_BALANCE_USD=

# AI Try-On Providers
AI_FEATURES_ENABLED=true
TRYON_TOKEN_COST=1
TRYON_VIDEO_TOKEN_COST=3
AI_PROVIDER=pruna
TRYON_VIDEO_PROVIDER=pixverse
# Disable only when the corresponding user-facing feature is intentionally unavailable.
PROFILE_FULL_BODY_GENERATION=true
CLOSET_GENERATION_ENABLED=true
PRUNA_API_KEY=
PRUNA_BASE_URL=https://api.pruna.ai
# Optional documented/account-specific endpoint used for a non-mutating Pruna health probe.
PRUNA_HEALTH_URL=
PRUNA_TRYON_MODEL=p-image-try-on
PRUNA_TRYON_TURBO=true
PRUNA_TRYON_OUTPUT_FORMAT=png
PRUNA_TRYON_OUTPUT_QUALITY=100
PRUNA_TRYON_PRESERVE_INPUT_SIZE=true
PRUNA_IMAGE_TRY_SYNC=false
PRUNA_IMAGE_POLL_ATTEMPTS=90
PRUNA_IMAGE_POLL_MS=1500
PRUNA_VIDEO_MODEL=p-video
PRUNA_VIDEO_DURATION=5
PRUNA_VIDEO_RESOLUTION=720p
PRUNA_VIDEO_ASPECT_RATIO=9:16
PRUNA_VIDEO_FPS=24
PRUNA_VIDEO_TRY_SYNC=false
PRUNA_VIDEO_POLL_ATTEMPTS=180
PRUNA_VIDEO_POLL_MS=2000
FAL_KEY=
# Separate FAL platform admin key required by the live usage endpoint.
FAL_ADMIN_KEY=
FAL_TRYON_VIDEO_MODEL=fal-ai/pixverse/v6/image-to-video
FAL_TRYON_VIDEO_RESOLUTION=540p
FAL_TRYON_VIDEO_DURATION=5
FAL_TRYON_VIDEO_CAMERA_MOVEMENT=fix_bg
FAL_VIDEO_POLL_ATTEMPTS=180
FAL_VIDEO_POLL_MS=2000
# AI Studio chatbot planner. Falls back to the local planner when disabled or unavailable.
FAL_AI_STUDIO_ENABLED=true
FAL_AI_STUDIO_ENDPOINT=openrouter/router/vision
FAL_AI_STUDIO_MODEL=google/gemini-2.5-flash-lite
FAL_AI_STUDIO_TIMEOUT_MS=20000
FAL_AI_STUDIO_MAX_TOKENS=720
FAL_AI_STUDIO_TEMPERATURE=0.25
AI_STUDIO_PRODUCT_RESULT_LIMIT=8
# Provider-neutral web shopping controls. Legacy AI_STUDIO_AMAZON_* values
# remain supported when upgrading an existing deployment.
AI_STUDIO_WEB_RESULT_LIMIT=10
AI_STUDIO_WEB_TIMEOUT_MS=2500
AI_STUDIO_DIRECT_WEB_FALLBACK_ENABLED=true
AI_STUDIO_CONVERSATION_TTL_DAYS=1
AI_STUDIO_DEBUG=false
# Short-lived bearer lifetime for provider-video proxy URLs (60-3600 seconds).
MEDIA_TOKEN_TTL_SECONDS=900
# Optional verified fallback used only when FAL's pricing endpoint is unavailable.
PIXVERSE_VIDEO_COST_USD=
FITROOM_API_KEY=
FITROOM_BASE_URL=https://platform.fitroom.app

# Catalog / Commerce
# Use serpapi for reliable structured shopping discovery. amazon-html remains a best-effort retailer fallback.
CATALOG_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
SERPAPI_AMAZON_DOMAIN=amazon.in
# Optional. Add only when Amazon affiliate attribution is wanted.
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_API_ACCESS_KEY=
AMAZON_API_SECRET_KEY=
SMART_CATALOG_IMPORT_MAX=12
SMART_CATALOG_SEARCH_PAGES=2
PRODUCT_READ_CACHE_TTL_MS=300000
RECOMMENDATION_READ_CACHE_TTL_MS=300000
RECOMMENDATION_CANDIDATE_POOL_SIZE=400
TRYON_IMAGE_CACHE_TTL_MS=900000
TRYON_IMAGE_CACHE_MAX_ITEMS=80

# Storage
STORAGE_PROVIDER=local
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_BASE_URL=
# Bunny account API key for bandwidth/request statistics. This is not the Storage API password.
BUNNY_ACCOUNT_API_KEY=
BUNNY_RECONCILE_MAX_FILES=20000
BUNNY_RECONCILE_MAX_DEPTH=8
MEDIA_ORPHAN_DELETE_MIN_AGE_DAYS=7

# Background Removal
BACKGROUND_REMOVAL_PROVIDER=edge-mask
BACKGROUND_REMOVAL_MODELS=birefnet-general,isnet-general-use,u2net
BACKGROUND_REMOVAL_PYTHON=.venv-rembg/bin/python
BACKGROUND_REMOVAL_INFERENCE_LONG_SIDE=1024
BACKGROUND_REMOVAL_MASK_FEATHER=1.2
BACKGROUND_REMOVAL_MASK_CLOSE_SIZE=3
BACKGROUND_REMOVAL_CROP_PADDING=18
DEBUG_SUBJECT_ISOLATION=false
DEBUG_PRUNA_VIDEO_LOGS=false
ANALYTICS_RETENTION_DAYS=180
SESSION_HEARTBEAT_MAX_GAP_MS=60000
SESSION_INACTIVE_MS=900000
