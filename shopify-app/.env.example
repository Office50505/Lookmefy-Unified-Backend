# Lookmefy Shopify App environment example.
# Do not put production secrets in this file.

# Official Shopify React Router template variables.
# In local development, Shopify CLI can inject these while `npm run dev` is running.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=
SHOP_CUSTOM_DOMAIN=
DATABASE_URL=file:dev.sqlite

# Phase 3 expected scope change.
# Adding read_products will require merchant reauthorization.
PHASE3_EXPECTED_SCOPES=read_products

# Future internal Lookmefy service adapter. Not used in Phase 2.
LOOKMEFY_INTERNAL_API_BASE_URL=
LOOKMEFY_INTERNAL_API_TOKEN=
LOOKMEFY_SHOPIFY_WEBHOOK_SIGNING_SECRET=

# Future Shopify merchant billing. Not used in Phase 2.
SHOPIFY_BILLING_TEST=true
SHOPIFY_MONTHLY_PLAN_NAME=
SHOPIFY_MONTHLY_PLAN_PRICE=

# Future storefront uploads and result retention. Not used in Phase 2.
SHOPIFY_TRYON_UPLOAD_MAX_BYTES=8388608
SHOPIFY_TRYON_RESULT_TTL_DAYS=30
SHOPIFY_TRYON_RATE_LIMIT_WINDOW_MS=60000
SHOPIFY_TRYON_RATE_LIMIT_MAX=10

# Future Shopify-specific queue. Not used in Phase 2.
SHOPIFY_QUEUE_ENABLED=true
SHOPIFY_REDIS_URL=

