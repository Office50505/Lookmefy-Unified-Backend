{
  "name": "lookmefy-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "/opt/homebrew/opt/node@20/bin/node node_modules/expo/bin/cli start",
    "android": "/opt/homebrew/opt/node@20/bin/node node_modules/expo/bin/cli start --android --port 8081",
    "ios": "/opt/homebrew/opt/node@20/bin/node node_modules/expo/bin/cli start --ios --port 8081",
    "ios:prebuild": "/opt/homebrew/opt/node@20/bin/node node_modules/expo/bin/cli prebuild --platform ios",
    "ios:build": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --profile production --latest",
    "ios:testflight": "eas build --platform ios --profile production --auto-submit",
    "web": "/opt/homebrew/opt/node@20/bin/node node_modules/expo/bin/cli start --web --port 8081"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-iap"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/bodoni-moda": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-iap": "^5.5.0",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.10"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "js-yaml@>=3.0.0 <3.15.1": "3.15.2",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tar": "7.5.22",
    "undici": "6.28.0"
  }
}
