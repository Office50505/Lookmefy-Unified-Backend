# FitLook production knobs. Copy into your real environment manager, not .env in git.

NODE_ENV=production
SERVICE_NAME=fitlook-api
CLIENT_ORIGIN=https://www.lookmefy.com
ADMIN_ORIGIN=https://admin.lookmefy.com
ALLOWED_ORIGINS=https://lookmefy.com,https://www.lookmefy.com

# Required secrets. Generate a unique JWT secret of at least 32 random characters.
MONGODB_URI=mongodb+srv://user:password@cluster.example/fitlook
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_KEY=replace-with-random-admin-key

# Required for multi-instance cache, rate-limit state, and queue lock coordination.
REDIS_URL=redis://default:password@redis.example:6379
CACHE_REDIS_ENABLED=1
REDIS_KEY_PREFIX=fitlook
REDIS_TIMEOUT_MS=250
REDIS_BACKOFF_MS=60000

# Queue. Use JOB_WORKER_ENABLED=0 only when a separate worker process runs the same codebase.
ASYNC_JOBS_ENABLED=1
JOB_WORKER_ENABLED=1
JOB_WORKER_CONCURRENCY=2
JOB_WORKER_POLL_MS=1500
JOB_STALE_LOCK_MS=600000
JOB_RESULT_TTL_MS=86400000

# App rate limits.
# Set false only for controlled load tests or emergency debugging.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_MAX=120
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_OTP_PHONE_MAX=3
RATE_LIMIT_OTP_IP_MAX=10
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_AI_SEARCH_USER_MAX=10
RATE_LIMIT_AI_SEARCH_IP_MAX=20
RATE_LIMIT_TRYON_IMAGE_MINUTE_MAX=15
RATE_LIMIT_TRYON_VIDEO_MINUTE_MAX=10
RATE_LIMIT_TRYON_IMAGE_LOCK_MS=180000
RATE_LIMIT_TRYON_VIDEO_LOCK_MS=480000
RATE_LIMIT_PROFILE_UPLOAD_HOUR_MAX=10
RATE_LIMIT_CLOSET_UPLOAD_HOUR_MAX=30
RATE_LIMIT_PAYMENT_MINUTE_MAX=5

# Pruna image try-on. Store the real API key only in your secret manager.
PRUNA_API_KEY=
PRUNA_BASE_URL=https://api.pruna.ai/v1
PRUNA_TRYON_MODEL=p-image-try-on
PRUNA_GLASSES_MODEL=p-try-on-glasses
PRUNA_TRYON_SYNC=false
PRUNA_TRYON_TURBO=true
PRUNA_TRYON_OUTPUT_FORMAT=jpg
PRUNA_TRYON_OUTPUT_QUALITY=95
PRUNA_TRYON_PRESERVE_INPUT_SIZE=true
PRUNA_VIDEO_MODEL=p-video
PRUNA_VIDEO_DURATION=5
PRUNA_VIDEO_RESOLUTION=720p
PRUNA_VIDEO_FPS=24
PRUNA_VIDEO_DRAFT=false
PRUNA_VIDEO_ASPECT_RATIO=
PRUNA_UPLOAD_TIMEOUT_MS=30000
PRUNA_SUBMIT_TIMEOUT_MS=15000
PRUNA_STATUS_TIMEOUT_MS=12000
PRUNA_DOWNLOAD_TIMEOUT_MS=30000
PRUNA_POLL_ATTEMPTS=45
PRUNA_POLL_MS=1000

# AI providers. Required by production startup validation.
FAL_KEY=
FITROOM_API_KEY=
FITROOM_BASE_URL=https://platform.fitroom.app

# Server-side remote image download guardrails.
REMOTE_IMAGE_TIMEOUT_MS=15000
REMOTE_IMAGE_MAX_BYTES=8388608

# OTP must not expose dev codes in production.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LKMEFY
MSG91_TEMPLATE_ID=
AUTH_OTP_EXPOSE=0
AUTH_FIXED_OTP=
AUTH_OTP_EXPIRY_MINUTES=10
AUTH_OTP_FAILURE_MAX=5
AUTH_OTP_FAILURE_WINDOW_MS=600000
AUTH_OTP_FAILURE_BLOCK_MS=900000

# Dev bypasses must remain disabled in production.
ENABLE_DEV_MODE_BYPASS=0
SIGNUP_DEV_MODE_DEFAULT=0
SIGNUP_FREE_TOKENS=8
TRYON_TOKEN_COST=1
TRYON_VIDEO_TOKEN_COST=3
ALLOW_USER_DEV_MODE_TOGGLE=0
ALLOW_LEGACY_EMAIL_SIGNUP=0

# Remote object storage is required in production.
STORAGE_PROVIDER=bunny
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_URL=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_BASE_PATH=uploads
ALLOW_LOCAL_UPLOADS=0
MEDIA_URL_TTL_SECONDS=86400

# PhonePe checkout.
PAYMENTS_ENABLED=1
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_REDIRECT_URL=https://www.lookmefy.com/tokens
PHONEPE_ALLOWED_REDIRECT_SCHEMES=lookmefy,com.kratikdhote.lookmefy
PHONEPE_UPI_TARGET_APP=com.phonepe.app
PHONEPE_SUBSCRIPTION_FREQUENCY=ON_DEMAND
PHONEPE_REDEMPTION_RETRY_STRATEGY=STANDARD

# Apple StoreKit / App Store Server API for production iOS in-app purchases.
# Product IDs must match App Store Connect exactly:
#   com.lookmefy.premium.monthly
#   com.lookmefy.credits50
#   com.lookmefy.credits75
#   com.lookmefy.credits110
#   com.lookmefy.credits135
#   com.lookmefy.credits400
APPLE_IAP_ENVIRONMENT=production
APPLE_BUNDLE_ID=com.kratikdhote.lookmefy
APPLE_APP_APPLE_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_PRIVATE_KEY=
APPLE_ROOT_CA_CERTS_DIR=
APPLE_ROOT_CA_CERT_PATHS=
APPLE_ROOT_CA_CERTS_BASE64=
